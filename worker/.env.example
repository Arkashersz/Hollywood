# Copie para worker/.env e preencha neste computador. Nunca versione nem compartilhe este arquivo.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_LOCALLY_NEVER_COMMIT
WORKER_ID=home-pc-01
POLL_SECONDS=5

# Cérebro (análise, roteiro e prompts): claude = Claude Code deste PC, com a sua assinatura
# (rode `claude` uma vez para fazer login). chatgpt = ChatGPT do navegador, como reserva.
BRAIN=claude
# CLAUDE_MODEL=opus
# CLAUDE_EFFORT=low   # low (padrão, ~3 min por texto) | medium | high: mais alto = mais elaborado, porém muito mais lento

# Chrome do worker (perfil dedicado; o login é feito por você com `python -m app.cli login`)
BROWSER_PROFILE_DIR=./browser-profiles/studio
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CDP_PORT=9333

# Análise local
WHISPER_MODEL=small
# REFERENCE_LANGUAGE=de        # force o idioma da fala se a detecção automática errar

# Duração máxima por clipe usada no roteiro. Confira o limite real na interface do Grok.
GROK_MAX_CLIP_SECONDS=6

# Pausa entre gerações consecutivas (segundos)
PAUSE_BETWEEN_ITEMS=8
